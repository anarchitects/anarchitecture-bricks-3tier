{
  "name": "angular-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "tools/angular-docs",
  "sourceRoot": "tools/angular-docs",
  "projectType": "library",
  "tags": ["scope:docs", "type:angular-docs"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        {
          "fileset": "{workspaceRoot}/libs/auth/angular/**/*"
        },
        {
          "fileset": "{workspaceRoot}/libs/forms/angular/**/*"
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/docs/compodoc",
        "{workspaceRoot}/libs/storybook/angular/.storybook/compodoc.ts"
      ],
      "options": {
        "command": "rm -rf dist/docs/compodoc && yarn nx run-many -t compodoc -p auth-angular forms-angular && yarn nx run angular-docs:merge-json"
      }
    },
    "merge-json": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        {
          "fileset": "{workspaceRoot}/dist/docs/compodoc/**/json/documentation.json"
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/docs/compodoc/merged",
        "{workspaceRoot}/libs/storybook/angular/.storybook/compodoc.ts"
      ],
      "options": {
        "command": "node tools/angular-docs/merge-compodoc-json.mjs"
      }
    }
  }
}
