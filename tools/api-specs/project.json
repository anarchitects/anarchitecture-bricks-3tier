{
  "name": "api-specs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "tools/api-specs",
  "sourceRoot": "tools/api-specs",
  "projectType": "library",
  "tags": ["scope:docs", "type:api-specs"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        {
          "fileset": "{workspaceRoot}/libs/auth/nest/src/**/*"
        },
        {
          "fileset": "{workspaceRoot}/libs/forms/nest/src/**/*"
        },
        {
          "fileset": "{workspaceRoot}/libs/identity/nest/src/**/*"
        },
        {
          "fileset": "{workspaceRoot}/libs/auth/ts/src/**/*"
        },
        {
          "fileset": "{workspaceRoot}/libs/forms/ts/src/**/*"
        },
        {
          "fileset": "{workspaceRoot}/libs/identity/ts/src/**/*"
        },
        {
          "fileset": "{workspaceRoot}/libs/newsletter/nest/src/**/*"
        },
        {
          "fileset": "{workspaceRoot}/libs/newsletter/ts/src/**/*"
        }
      ],
      "outputs": ["{workspaceRoot}/docs/openapi"],
      "options": {
        "command": "yarn exec tsx --no-cache --tsconfig tsconfig.base.json tools/api-specs/generate.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["generate"],
      "inputs": [
        "default",
        {
          "fileset": "{workspaceRoot}/docs/openapi/openapi.yaml"
        }
      ],
      "options": {
        "command": "spectral lint docs/openapi/openapi.yaml"
      }
    },
    "diff": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "yarn exec tsx --no-cache --tsconfig tsconfig.base.json tools/api-specs/diff.ts"
      },
      "cache": false
    },
    "mock": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "yarn exec prism mock docs/openapi/openapi.yaml -p 4010"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "yarn exec tsx --no-cache --tsconfig tsconfig.base.json tools/api-specs/verify.ts"
      },
      "cache": false
    },
    "audit-legacy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/api-specs/audit-legacy.mjs"
      }
    },
    "audit-legacy-validation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "yarn exec tsx --no-cache --tsconfig tsconfig.base.json tools/api-specs/probe-legacy-validation.ts"
      }
    },
    "audit-legacy-verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["audit-legacy", "audit-legacy-validation"],
      "options": {
        "command": "node tools/api-specs/verify-legacy-audit.mjs"
      }
    },
    "audit-legacy-lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "yarn exec eslint tools/api-specs/audit-legacy.mjs tools/api-specs/probe-legacy-validation.ts tools/api-specs/verify-legacy-audit.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "yarn exec tsx --no-cache --tsconfig tsconfig.base.json --test tools/api-specs/conformance.spec.ts"
      },
      "dependsOn": ["generate"]
    },
    "conformance-http": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["release-tools"],
          "target": "validate-nest-package-compatibility"
        }
      ],
      "options": {
        "commands": [
          "node tools/testing/run-auth-nest-host.mjs nest11",
          "node tools/testing/run-forms-identity-nest-host.mjs nest11",
          "node tools/testing/run-newsletter-nest-host.mjs nest11"
        ],
        "parallel": false
      },
      "configurations": {
        "nest12": {
          "commands": [
            "node tools/testing/run-auth-nest-host.mjs nest12",
            "node tools/testing/run-forms-identity-nest-host.mjs nest12",
            "node tools/testing/run-newsletter-nest-host.mjs nest12"
          ]
        }
      }
    },
    "lint-tools": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn exec eslint tools/api-specs/canonical-artifacts.mjs tools/api-specs/compatibility.mjs tools/api-specs/route-metadata.ts tools/api-specs/verify.ts tools/api-specs/diff.ts tools/api-specs/conformance.spec.ts tools/testing/canonical-http.cts"
      }
    }
  }
}
