{
  "name": "release-tools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "tools/release",
  "sourceRoot": "tools/release",
  "projectType": "library",
  "tags": ["scope:release", "type:tooling"],
  "targets": {
    "test-nest-development-host": {
      "executor": "nx:run-commands",
      "cache": false,
      "defaultConfiguration": "nest12",
      "options": {
        "command": "node tools/testing/run-nest-development-host.mjs 12"
      },
      "configurations": {
        "nest11": {
          "command": "node tools/testing/run-nest-development-host.mjs 11"
        },
        "nest12": {
          "command": "node tools/testing/run-nest-development-host.mjs 12"
        }
      }
    },
    "validate-domain-tags": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/validate-domain-tags.mjs"
      }
    },
    "validate-angular-package-compatibility": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/validate-angular-package-compatibility.mjs"
      }
    },
    "validate-angular-packed-manifests": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "auth-angular",
          "target": "build"
        },
        {
          "projects": "forms-angular",
          "target": "build"
        },
        {
          "projects": "identity-angular",
          "target": "build"
        }
      ],
      "options": {
        "command": "node tools/release/validate-angular-package-compatibility.mjs --dist"
      }
    },
    "validate-typeorm-package-compatibility": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "auth-nest",
          "target": "build"
        },
        {
          "projects": "forms-nest",
          "target": "build"
        },
        {
          "projects": "identity-nest",
          "target": "build"
        }
      ],
      "options": {
        "command": "node tools/release/validate-typeorm-package-compatibility.mjs"
      }
    },
    "test-typeorm-persistence": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "auth-nest",
          "target": "build"
        },
        {
          "projects": "forms-nest",
          "target": "build"
        },
        {
          "projects": "identity-nest",
          "target": "build"
        }
      ],
      "cache": false,
      "parallelism": false,
      "options": {
        "command": "node tools/testing/run-typeorm-v1-persistence-smoke.mjs"
      }
    },
    "verify-domain-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/verify-domain-boundaries.mjs"
      }
    },
    "normalize-internal-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/normalize-internal-dependency-versions.mjs"
      }
    },
    "normalize-external-peer-ranges": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/normalize-external-peer-ranges.mjs"
      }
    },
    "check-release-tag-ancestry": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/check-release-tag-ancestry.mjs"
      }
    },
    "validate-non-bumping-commits": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/validate-non-bumping-commits.mjs"
      }
    },
    "domain-release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/run-domain-release.mjs"
      }
    },
    "validate-tailwind-registry": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/release/validate-tailwind-registry-release.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/libs/common/nest/mailer/package.json",
        "{workspaceRoot}/libs/common/nest/mailer/tests/hosts/**/*",
        "{workspaceRoot}/tools/testing/run-common-mailer-nest-host.mjs",
        "{workspaceRoot}/tools/testing/auth-nest-hosts/**/*",
        "{workspaceRoot}/tools/testing/run-auth-nest-host.mjs",
        "{workspaceRoot}/libs/auth/{nest,declarations,ts}/package.json",
        "{workspaceRoot}/tools/testing/forms-identity-nest-hosts/**/*",
        "{workspaceRoot}/tools/testing/run-forms-identity-nest-host.mjs",
        "{workspaceRoot}/libs/{forms,identity}/{nest,ts}/package.json"
      ],
      "options": {
        "command": "node --test tools/release/domain-release-lib.spec.mjs tools/release/release-workflows.spec.mjs tools/release/tailwind-registry-validation-lib.spec.mjs tools/release/newsletter-workspace.spec.mjs tools/release/nest-development-host.spec.mjs tools/release/common-mailer-nest-host.spec.mjs tools/release/auth-nest-host.spec.mjs tools/release/forms-identity-nest-host.spec.mjs"
      }
    },
    "test-forms-identity-nest-compatibility": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["forms-nest", "identity-nest"],
          "target": "build"
        }
      ],
      "cache": false,
      "parallelism": false,
      "defaultConfiguration": "nest12",
      "options": {
        "command": "node tools/testing/run-forms-identity-nest-host.mjs nest12"
      },
      "configurations": {
        "nest11": {
          "command": "node tools/testing/run-forms-identity-nest-host.mjs nest11"
        },
        "nest11-modern": {
          "command": "node tools/testing/run-forms-identity-nest-host.mjs nest11-modern"
        },
        "nest12": {
          "command": "node tools/testing/run-forms-identity-nest-host.mjs nest12"
        }
      }
    }
  }
}
