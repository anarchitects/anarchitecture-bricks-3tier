{
  "name": "release-tools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "tools/release",
  "sourceRoot": "tools/release",
  "projectType": "library",
  "tags": ["scope:release", "type:tooling"],
  "targets": {
    "validate-domain-tags": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/validate-domain-tags.mjs"
      }
    },
    "normalize-internal-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/normalize-internal-dependency-versions.mjs"
      }
    },
    "normalize-external-peer-ranges": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/normalize-external-peer-ranges.mjs"
      }
    },
    "check-release-tag-ancestry": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/check-release-tag-ancestry.mjs"
      }
    },
    "validate-non-bumping-commits": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/release/validate-non-bumping-commits.mjs"
      }
    }
  }
}
