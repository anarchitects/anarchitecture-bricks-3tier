{
  "name": "docs-hub",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "tools/docs-hub",
  "sourceRoot": "tools/docs-hub",
  "projectType": "library",
  "tags": ["scope:docs", "type:docs-hub"],
  "targets": {
    "sync-packages": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        {
          "fileset": "{workspaceRoot}/libs/**/package.json"
        },
        {
          "fileset": "{workspaceRoot}/libs/**/README.md"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/docs-hub/data"],
      "options": {
        "command": "node tools/docs-hub/sync-packages.mjs"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["sync-packages"],
      "inputs": [
        "default",
        {
          "fileset": "{workspaceRoot}/docs/guides/**/*.md"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/docs-hub"],
      "options": {
        "command": "node tools/docs-hub/build.mjs"
      }
    },
    "validate-content": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        {
          "fileset": "{workspaceRoot}/docs/guides/**/*.md"
        },
        {
          "fileset": "{workspaceRoot}/libs/**/package.json"
        },
        {
          "fileset": "{workspaceRoot}/libs/**/README.md"
        }
      ],
      "options": {
        "command": "node tools/docs-hub/validate-content.mjs"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "options": {
        "command": "node tools/docs-hub/verify.mjs"
      }
    }
  }
}
