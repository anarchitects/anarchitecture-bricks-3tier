{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@anarchitects/common-nest-config-mailer": [
        "libs/common/nest/config/mailer/src/index.ts"
      ],
      "@anarchitects/contacts-angular-data-access": [
        "libs/contacts/angular/data-access/src/index.ts"
      ],
      "@anarchitects/contacts-angular-feature": [
        "libs/contacts/angular/feature/src/index.ts"
      ],
      "@anarchitects/contacts-nest-application": [
        "libs/contacts/nest/application/src/index.ts"
      ],
      "@anarchitects/contacts-nest-infra-mailer": [
        "libs/contacts/nest/infra/mailer/src/index.ts"
      ],
      "@anarchitects/contacts-nest-infra-persistence": [
        "libs/contacts/nest/infra/persistence/src/index.ts"
      ],
      "@anarchitects/contacts-nest-presentation": [
        "libs/contacts/nest/presentation/src/index.ts"
      ],
      "@anarchitects/contacts-ts-dtos": ["libs/contacts/ts/dtos/src/index.ts"],
      "@anarchitects/contacts-ts-models": [
        "libs/contacts/ts/models/src/index.ts"
      ],
      "@anarchitects/ts-frontend-data-access": [
        "libs/ts/frontend/data-access/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
