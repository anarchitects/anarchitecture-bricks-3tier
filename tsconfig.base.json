{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@anarchitects/contacts-angular": ["libs/contacts/angular/src/index.ts"],
      "@anarchitects/contacts-angular/data-access": [
        "libs/contacts/angular/src/data-access/src/index.ts"
      ],
      "@anarchitects/contacts-angular/feature": [
        "libs/contacts/angular/src/feature/src/index.ts"
      ],
      "@anarchitects/contacts-angular/state": [
        "libs/contacts/angular/src/state/src/index.ts"
      ],
      "@anarchitects/contacts-angular/ui": [
        "libs/contacts/angular/src/ui/src/index.ts"
      ],
      "@anarchitects/contacts-nest": ["libs/contacts/nest/src/index.ts"],
      "@anarchitects/contacts-ts": ["libs/contacts/ts/src/index.ts"],
      "@anarchitects/contacts-ts/*": ["libs/contacts/ts/src/lib/*"],
      "@anarchitects/contacts-ts/dtos": ["libs/contacts/ts/src/dtos/index.ts"],
      "@anarchitects/contacts-ts/models": [
        "libs/contacts/ts/src/models/index.ts"
      ],
      "@anarchitects/ts-frontend-data-access": [
        "libs/ts/frontend/data-access/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
