{
  "name": "forms-angular-example",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "examples/forms-angular-example/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/examples/forms-angular-example",
        "browser": "examples/forms-angular-example/src/main.ts",
        "tsConfig": "examples/forms-angular-example/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "examples/forms-angular-example/public"
          }
        ],
        "styles": ["examples/forms-angular-example/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "forms-angular-example:build:production"
        },
        "development": {
          "buildTarget": "forms-angular-example:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "examples/forms-angular-example/jest.config.cts",
        "tsConfig": "examples/forms-angular-example/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "forms-angular-example:build",
        "port": 4200,
        "staticFilePath": "dist/examples/forms-angular-example/browser",
        "spa": true
      }
    },
    "contract-test": {
      "executor": "nx:run-commands",
      "dependsOn": ["api-specs:generate"],
      "options": {
        "command": "node tools/api-specs/run-prism-jest.mjs examples/forms-angular-example/jest.contract.config.cts src/contract/forms-api.contract.spec.ts"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn nx run forms-angular-example-e2e:e2e"
      }
    }
  }
}
