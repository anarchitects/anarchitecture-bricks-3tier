{
  "name": "auth-angular-example-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "examples/auth-angular-example-e2e/src",
  "implicitDependencies": ["auth-angular-example", "auth-nest"],
  "// targets": "to see all targets run: nx show project auth-angular-example-e2e --web",
  "targets": {
    "passkey-contract-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["auth-angular-example", "auth-nest"],
          "target": "build"
        }
      ],
      "options": {
        "command": "playwright test --config=examples/auth-angular-example-e2e/playwright.passkeys.config.mts"
      },
      "outputs": ["{workspaceRoot}/dist/.playwright/auth-passkey-contracts"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p examples/auth-angular-example-e2e/tsconfig.contract.json --noEmit"
      }
    }
  }
}
