{
  "name": "auth-nest-example-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["auth-nest-example"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "examples/auth-nest-example-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["auth-nest-example:build", "auth-nest-example:serve"]
    }
  }
}
