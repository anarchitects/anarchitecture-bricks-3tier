{
  "name": "forms-nest-example-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "forms-nest-example"
  ],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}"
      ],
      "options": {
        "jestConfig": "examples/forms-nest-example-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": [
        "forms-nest-example:build",
        "forms-nest-example:serve"
      ]
    }
  }
}
