{
  "name": "@anarchitects/identity-ts",
  "version": "0.0.2",
  "description": "Shared identity models and TypeBox DTO schemas for the Anarchitecture identity domain.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-bricks-3tier.git",
    "directory": "libs/identity/ts"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-bricks-3tier/tree/main/libs/identity/ts",
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-bricks-3tier/issues"
  },
  "keywords": [
    "identity",
    "profile",
    "anarchitecture"
  ],
  "dependencies": {
    "@sinclair/typebox": "0.34.41"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./dtos": {
      "types": "./dtos/index.d.ts",
      "import": "./dtos/index.js",
      "require": "./dtos/index.cjs"
    },
    "./models": {
      "types": "./models/index.d.ts",
      "import": "./models/index.js",
      "require": "./models/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
