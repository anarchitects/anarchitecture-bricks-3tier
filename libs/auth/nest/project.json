{
  "name": "auth-nest",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auth/nest/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["domain:auth", "tech:nest", "auth:runtime"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/auth/nest",
        "tsConfig": "libs/auth/nest/tsconfig.lib.json",
        "packageJson": "libs/auth/nest/package.json",
        "main": "libs/auth/nest/src/index.ts",
        "assets": ["libs/auth/nest/*.md"],
        "additionalEntryPoints": [
          "libs/auth/nest/src/application/index.ts",
          "libs/auth/nest/src/infrastructure-mailer/index.ts",
          "libs/auth/nest/src/infrastructure-persistence/index.ts",
          "libs/auth/nest/src/presentation/index.ts",
          "libs/auth/nest/src/config/index.ts"
        ],
        "generateExportsField": true
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/auth/nest/jest.config.ts"
      },
      "dependsOn": ["test-passkeys"]
    },
    "test-passkeys": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/testing/auth-nest-passkeys.test.mjs",
        "{workspaceRoot}/tools/testing/webauthn-fixture.mjs"
      ],
      "options": {
        "command": "node --test tools/testing/auth-nest-passkeys.test.mjs"
      }
    },
    "test-nest-compatibility": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "parallelism": false,
      "defaultConfiguration": "nest12",
      "options": {
        "command": "node tools/testing/run-auth-nest-host.mjs nest12"
      },
      "configurations": {
        "nest11": {
          "command": "node tools/testing/run-auth-nest-host.mjs nest11"
        },
        "nest11-modern": {
          "command": "node tools/testing/run-auth-nest-host.mjs nest11-modern"
        },
        "nest12": {
          "command": "node tools/testing/run-auth-nest-host.mjs nest12"
        }
      }
    }
  }
}
