{
  "name": "@anarchitects/auth-nest",
  "version": "0.10.0",
  "type": "commonjs",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "dependencies": {
    "@anarchitects/auth-declarations": "^0.10.0",
    "@anarchitects/better-auth-typeorm-adapter": "0.2.0",
    "@better-auth/core": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "@sinclair/typebox": "^0.34.41",
    "@better-auth/passkey": "~1.7.2",
    "@anarchitects/auth-ts": "^0.10.0",
    "@anarchitects/common-nest-mailer": "^0.3.3",
    "@casl/ability": "^6.7.3",
    "@opentelemetry/api": "^1.9.0",
    "bcrypt": "^6.0.0",
    "better-auth": "~1.7.2",
    "better-call": "1.4.0",
    "jose": "^6.2.3",
    "kysely": "^0.29.0",
    "nanostores": "^1.3.0",
    "tslib": "^2.3.0",
    "uuidv7": "^1.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/typeorm": "^11.0.1",
    "typeorm": "^1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "application": [
        "src/application/index.d.ts"
      ],
      "infrastructure-mailer": [
        "src/infrastructure-mailer/index.d.ts"
      ],
      "infrastructure-persistence": [
        "src/infrastructure-persistence/index.d.ts"
      ],
      "presentation": [
        "src/presentation/index.d.ts"
      ],
      "config": [
        "src/config/index.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-bricks-3tier.git",
    "directory": "libs/auth/nest"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-bricks-3tier/tree/main/libs/auth/nest",
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-bricks-3tier/issues"
  },
  "nx": {
    "targets": {
      "test-published-adapter": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "yarn node tools/testing/run-auth-nest-published-adapter-smoke.mjs"
        },
        "parallelism": false,
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/jest.preset.js"
        ]
      }
    }
  }
}
