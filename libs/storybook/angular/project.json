{
  "name": "storybook-angular",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/storybook/angular/src",
  "prefix": "anarchitects",
  "projectType": "library",
  "tags": ["domain:storybook", "tech:angular"],
  "targets": {
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "dependsOn": [
        {
          "projects": "angular-docs",
          "target": "generate"
        }
      ],
      "options": {
        "port": 4400,
        "configDir": "libs/storybook/angular/.storybook",
        "browserTarget": "storybook-angular:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "dependsOn": [
        {
          "projects": "angular-docs",
          "target": "generate"
        }
      ],
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/storybook-angular",
        "configDir": "libs/storybook/angular/.storybook",
        "browserTarget": "storybook-angular:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "angular-docs",
          "target": "generate"
        }
      ],
      "options": {
        "command": "test-storybook -c libs/storybook/angular/.storybook --url=http://localhost:4400"
      }
    },
    "tailwind-css-contract": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "options": {
        "command": "node tools/tailwind/validate-consumer-css.mjs --target=storybook"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "storybook-angular:build-storybook",
        "staticFilePath": "dist/storybook/storybook-angular",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "storybook-angular:build-storybook:ci"
        }
      }
    }
  }
}
