{
  "name": "common-angular-design",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/common/angular/design/src",
  "prefix": "anarchitects",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["domain:shared", "tech:angular"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/common/angular/design/ng-package.json",
        "tsConfig": "libs/common/angular/design/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/common/angular/design/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/common/angular/design/jest.config.cts",
        "tsConfig": "libs/common/angular/design/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "compodoc": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/docs/compodoc/common-angular-design"],
      "options": {
        "command": "rm -rf dist/docs/compodoc/common-angular-design && yarn exec compodoc libs/common/angular/design/src -p libs/common/angular/design/tsconfig.lib.json -d dist/docs/compodoc/common-angular-design/html --disableCoverage --disableGraph --silent && yarn exec compodoc libs/common/angular/design/src -p libs/common/angular/design/tsconfig.lib.json -d dist/docs/compodoc/common-angular-design/json -e json --disableCoverage --disableGraph --silent"
      }
    }
  }
}
