{
  "name": "newsletter-angular",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/newsletter/angular",
  "prefix": "anarchitects",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["domain:newsletter", "tech:angular", "type:facade"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/newsletter/angular/ng-package.json",
        "tsConfig": "libs/newsletter/angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/newsletter/angular/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["^nx-release-publish"],
      "options": {
        "packageRoot": "dist/libs/newsletter/angular"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "tsConfig": "libs/newsletter/angular/tsconfig.spec.json",
        "include": ["**/*.spec.ts", "**/*.test.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "command": "tsc --noEmit -p libs/newsletter/angular/tsconfig.lib.json"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc --noEmit -p libs/newsletter/angular/tsconfig.spec.json"
      }
    },
    "package-smoke": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["default", "^production"],
      "options": {
        "command": "node libs/newsletter/angular/tests/package-smoke.mjs"
      }
    },
    "test-hydration": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["default", "^production"],
      "options": {
        "command": "node libs/newsletter/angular/tests/hydration-privacy.mjs"
      }
    }
  }
}
