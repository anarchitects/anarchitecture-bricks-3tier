{
  "name": "@anarchitects/newsletter-ts",
  "version": "0.0.1",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "description": "Framework-neutral Newsletter subscription schemas and consent evidence contracts.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-bricks-3tier.git",
    "directory": "libs/newsletter/ts"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-bricks-3tier/tree/main/libs/newsletter/ts",
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-bricks-3tier/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./dtos": {
      "import": {
        "types": "./dtos/index.d.ts",
        "default": "./dtos/index.js"
      },
      "require": {
        "types": "./dtos/index.d.cts",
        "default": "./dtos/index.cjs"
      }
    },
    "./models": {
      "import": {
        "types": "./models/index.d.ts",
        "default": "./models/index.js"
      },
      "require": {
        "types": "./models/index.d.cts",
        "default": "./models/index.cjs"
      }
    }
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.41"
  }
}
