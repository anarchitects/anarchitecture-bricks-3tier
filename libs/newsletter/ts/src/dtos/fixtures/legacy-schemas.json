{
  "revision": "268f6d46730ae8fe16816abd61c4f789666cc227",
  "purpose": "Frozen legacy test oracle, never contract authority",
  "schemas": {
    "NewsletterNativeActionRequestSchema": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "token": {
          "maxLength": 128,
          "type": "string"
        }
      },
      "required": ["token"]
    },
    "NewsletterNativeActionResponseSchema": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "accepted": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": ["accepted"]
    },
    "NewsletterSubscriptionRequestSchema": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "email": {
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+(?![\\s\\S])",
          "type": "string"
        },
        "consent": {
          "const": true,
          "type": "boolean"
        },
        "consentVersion": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "source": {
          "maxLength": 2048,
          "type": "string"
        },
        "website": {
          "maxLength": 2048,
          "type": "string"
        }
      },
      "required": ["email", "consent", "consentVersion"]
    },
    "NewsletterSubscriptionResponseSchema": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "accepted": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": ["accepted"]
    },
    "NewsletterWebhookResponseSchema": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "recorded": {
          "minimum": 0,
          "type": "integer"
        },
        "duplicates": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["recorded", "duplicates"]
    }
  }
}
