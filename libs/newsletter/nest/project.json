{
  "name": "newsletter-nest",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/newsletter/nest/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["domain:newsletter", "tech:nest", "type:facade"],
  "targets": {
    "package-smoke": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["default", "^production"],
      "options": {
        "command": "node libs/newsletter/nest/tests/package-smoke.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "options": {
        "command": "tsc --noEmit -p libs/newsletter/nest/tsconfig.lib.json"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc --noEmit -p libs/newsletter/nest/tsconfig.spec.json"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/newsletter/nest",
        "tsConfig": "libs/newsletter/nest/tsconfig.lib.json",
        "packageJson": "libs/newsletter/nest/package.json",
        "main": "libs/newsletter/nest/src/index.ts",
        "assets": ["libs/newsletter/nest/*.md"],
        "additionalEntryPoints": [
          "libs/newsletter/nest/src/application/index.ts",
          "libs/newsletter/nest/src/config/index.ts",
          "libs/newsletter/nest/src/infrastructure-mailerlite/index.ts",
          "libs/newsletter/nest/src/infrastructure-persistence/index.ts",
          "libs/newsletter/nest/src/presentation/index.ts"
        ],
        "generateExportsField": true
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["^nx-release-publish"],
      "options": {
        "packageRoot": "dist/libs/newsletter/nest"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/newsletter/nest/jest.config.cts"
      }
    }
  }
}
