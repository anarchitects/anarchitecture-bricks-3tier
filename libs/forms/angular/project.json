{
  "name": "forms-angular",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/forms/angular",
  "prefix": "anarchitects",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["domain:forms", "tech:angular"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/forms/angular/ng-package.json",
        "tsConfig": "libs/forms/angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/forms/angular/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "tsConfig": "libs/forms/angular/tsconfig.spec.json",
        "include": ["**/*.spec.ts", "**/*.test.ts"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "compodoc": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/docs/compodoc/forms-angular"],
      "options": {
        "command": "rm -rf dist/docs/compodoc/forms-angular && yarn exec compodoc libs/forms/angular/src -p libs/forms/angular/tsconfig.lib.json -d dist/docs/compodoc/forms-angular/html --disableCoverage --disableGraph --silent && yarn exec compodoc libs/forms/angular/src -p libs/forms/angular/tsconfig.lib.json -d dist/docs/compodoc/forms-angular/json -e json --disableCoverage --disableGraph --silent"
      }
    }
  }
}
